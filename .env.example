# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# Which provider backs every agent. One of: anthropic | gemini | openai
# Defaults to "anthropic" if unset.
# LLM_PROVIDER=openai

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# --- Google Gemini (LLM_PROVIDER=gemini) ---
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=my_key

# --- OpenAI (LLM_PROVIDER=openai) ---
# Get a key at https://platform.openai.com/
# OPENAI_API_KEY=
# ---------------------------------------------------------------------------
# Optional per-tier model overrides
# ---------------------------------------------------------------------------
# Override the default model ids without editing src/config.py.
# "fast"  = cheap tool-calling agents; "smart" = stronger analytical agents.
#
# Anthropic defaults: FAST_MODEL=claude-haiku-4-5-20251001  SMART_MODEL=claude-sonnet-5
# Gemini    defaults: FAST_MODEL=gemini/gemini-flash-latest SMART_MODEL=gemini/gemini-pro-latest
# OpenAI    defaults: FAST_MODEL=gpt-4o-mini                SMART_MODEL=gpt-4o
#   (Free-tier keys have little/no Pro quota — set SMART_MODEL=gemini/gemini-flash-latest to avoid 429.)
#
# FAST_MODEL=
# SMART_MODEL=
